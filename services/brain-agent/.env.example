LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: load model/MCP settings saved in Open WebUI Admin Settings > Brain.
BRAIN_CONFIG_URL=http://localhost:8080/api/v1/brain/runtime-config
BRAIN_AGENT_SHARED_SECRET=replace-with-a-long-random-secret

# Brain inherits STT/TTS from Audio and the selected LLM from Connections.
# The MVP expects both Audio engines to be OpenAI-compatible.

# Optional Streamable HTTP MCP server.
BRAIN_MCP_URL=http://mcp.internal/mcp
BRAIN_MCP_ALLOWED_TOOLS=search_knowledge,query_incidents
BRAIN_MCP_CANCELLABLE_TOOLS=
BRAIN_MCP_HEADERS={}
BRAIN_MCP_TIMEOUT_SECONDS=120
